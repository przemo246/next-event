# Local: run `pnpm supabase start` and copy the printed values below.
# Production: copy from your linked project's API settings
# (https://supabase.com/dashboard/project/_/settings/api-keys).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only key used by the Playwright Supabase admin client.
# Local: copy `SECRET_KEY` (or the legacy `SERVICE_ROLE_KEY`) from
# `pnpm exec supabase status -o env`.
# Never expose this key with a `NEXT_PUBLIC_` prefix.
SUPABASE_SECRET_KEY=

# OAuth credentials for the login module (supabase/config.toml, auth.external.*).
# The Supabase CLI reads these when running `pnpm db:start`. Create the OAuth
# apps in the Google/Facebook developer consoles, using
# <SUPABASE_URL>/auth/v1/callback as the redirect URI.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_FACEBOOK_SECRET=
